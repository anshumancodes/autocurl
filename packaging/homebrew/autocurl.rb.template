# Copy this template to anshumancodes/homebrew-tap as Formula/autocurl.rb
# after the v0.1.0-beta.1 release assets are available. Replace every
# placeholder with the corresponding release asset URL and SHA-256 checksum.

class Autocurl < Formula
  desc "Generate and interactively execute API requests from source projects"
  homepage "https://autocurl.lol"
  version "__VERSION__"

  on_macos do
    if Hardware::CPU.arm?
      url "__MACOS_ARM64_URL__"
      sha256 "__MACOS_ARM64_SHA256__"
    else
      url "__MACOS_AMD64_URL__"
      sha256 "__MACOS_AMD64_SHA256__"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "__LINUX_ARM64_URL__"
      sha256 "__LINUX_ARM64_SHA256__"
    else
      url "__LINUX_AMD64_URL__"
      sha256 "__LINUX_AMD64_SHA256__"
    end
  end

  def install
    bin.install "autocurl"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/autocurl --version")
  end
end
